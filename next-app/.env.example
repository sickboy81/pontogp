# PocketBase (obrigatório)
NEXT_PUBLIC_POCKETBASE_URL=https://pocketbase.cerejavip.com
# Admin PocketBase (opcional; usado pelo webhook PIX para marcar pagamento e ativar plano)
# Mesmo email/senha do painel admin do PocketBase
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# Coleção de cupons no PocketBase: "coupons" (padrão) ou "cupons" (se os cupons não aparecerem na lista admin)
# POCKETBASE_COUPONS_COLLECTION=cupons

# URL do site (opcional; usado em sitemap, robots, meta)
NEXT_PUBLIC_APP_URL=https://cerejavip.com

# Cloudflare Turnstile - formulário de contato (opcional)
# Se não definido, o formulário funciona sem verificação de segurança
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# PixGo.org - pagamento PIX (obrigatório para planos pagos)
# API Key em https://pixgo.org (seção Checkouts)
# Header: X-API-Key
# Se não definido, aparece opção de simular pagamento
PIXGO_API_KEY=
# Webhook PixGo (opcional, recomendado em produção)
# Assinatura HMAC SHA256 do corpo bruto; se não definido, webhook aceita sem assinatura
PIXGO_WEBHOOK_SECRET=
# Header da assinatura (ex.: x-signature, x-webhook-signature)
PIXGO_WEBHOOK_SIGNATURE_HEADER=x-signature
VITE_PIXGO_API_KEY=

